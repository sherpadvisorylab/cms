{
  "name": "Footer",
  "slug": "footer",
  "template": "<footer class=\"fm-footer\"><div class=\"fm-inner\"><div class=\"fm-brand\"><a class=\"fm-name\" href=\"/\">{{ site.name }}</a><p class=\"fm-tagline\">{{ site.tagline }}</p></div><nav class=\"fm-links\">{% for item in menu %}<a class=\"fm-link\" href=\"{{ item.url }}\">{{ item.label }}</a>{% endfor %}</nav></div><div class=\"fm-bottom\"><span>&copy; {{ page.year | default: '2025' }} {{ site.name }}. All rights reserved.</span></div></footer>",
  "additionalCss": ".fm-footer{background:var(--bg-surface,#111827);color:#e5e7eb}.fm-inner{max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:2rem}.fm-brand{max-width:260px}.fm-name{font-size:1.2rem;font-weight:700;color:#fff;text-decoration:none}.fm-tagline{margin-top:.5rem;font-size:.85rem;color:#9ca3af;line-height:1.6}.fm-links{display:flex;flex-wrap:wrap;gap:.6rem 2.5rem}.fm-link{color:#9ca3af;text-decoration:none;font-size:.875rem;transition:color .15s}.fm-link:hover{color:#fff}.fm-bottom{max-width:1200px;margin:0 auto;padding:1.25rem 1.5rem;border-top:1px solid #1f2937;font-size:.8rem;color:#6b7280}",
  "additionalJs": "",
  "items": [
    { "type": "custom", "label": "Privacy Policy",    "url": "/privacy" },
    { "type": "custom", "label": "Terms & Conditions", "url": "/terms" }
  ]
}
